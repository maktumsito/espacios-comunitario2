rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Reservation validation
    function isValidReserva(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.fecha is string && data.fecha.size() <= 10 &&
             data.horaInicio is string && data.horaInicio.size() <= 5 &&
             data.horaFin is string && data.horaFin.size() <= 5 &&
             (data.terminaDiaSiguiente == true || data.horaFin > data.horaInicio) &&
             data.espacio is string && data.espacio.size() <= 150 &&
             data.responsable is string && data.responsable.size() <= 200 &&
             data.tipoActividad is string && data.tipoActividad.size() <= 100 &&
             data.descripcion is string && data.descripcion.size() <= 2000 &&
             (!('estado' in data) || (data.estado is string && data.estado.size() <= 50));
    }

    // System User validation
    function isValidUsuario(data) {
      return data.username is string && data.username.size() <= 150 &&
             data.name is string && data.name.size() <= 200 &&
             data.passwordHash is string && data.passwordHash.size() <= 256 &&
             data.role is string && data.role.size() <= 200;
    }

    // Space Rating validation
    function isValidCalificacion(data) {
      return data.id is string && data.id.size() <= 128 &&
             (data.reservaId is string || data.reservationId is string) &&
             data.espacio is string && data.espacio.size() <= 150 &&
             (data.puntaje is number || data.puntajeGeneral is number);
    }

    // System Configuration validation
    function isValidConfig(data) {
      return ('data' in data && (data.data is list || data.data is map)) ||
             ('schedule' in data && data.schedule is map) ||
             (data is map && ('updatedAt' in data || 'senderEmail' in data || 'id' in data));
    }

    // Audit Log validation (Append-only core data, controlled revert flag update, no deletion)
    function isValidAuditLog(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.timestamp is string && data.timestamp.size() <= 50 &&
             data.user is string && data.user.size() <= 150 &&
             data.action is string && data.action.size() <= 100 &&
             data.description is string && data.description.size() <= 10000;
    }

    function isValidAuditUpdate(data, prev) {
      return data.id == prev.id &&
             data.timestamp == prev.timestamp &&
             data.diff(prev).affectedKeys().hasOnly(['isReverted', 'revertedAt', 'revertedBy', 'restoreOperationId']) &&
             data.isReverted == true &&
             (!('isReverted' in prev) || prev.isReverted != true || data == prev);
    }

    // FCM Device Token validation
    function isValidFcmToken(data) {
      return data.token is string && data.token.size() <= 500 &&
             data.deviceId is string && data.deviceId.size() <= 128;
    }

    // FCM Notification validation
    function isValidFcmNotificacion(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.type is string && data.type.size() <= 50 &&
             data.title is string && data.title.size() <= 200 &&
             data.body is string && data.body.size() <= 1000 &&
             data.createdAt is string && data.createdAt.size() <= 50;
    }

    // Copia de Seguridad validation
    function isValidCopiaSeguridad(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.fecha is string && data.fecha.size() <= 10 &&
             data.timestamp is string && data.timestamp.size() <= 50 &&
             data.tipo is string && data.tipo.size() <= 50 &&
             data.totalReservas is number;
    }

    function isValidCopiaSeguridadParte(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.backupId is string && data.backupId.size() <= 128 &&
             data.index is number &&
             data.payload is string;
    }

    // Space Block / Maintenance validation
    function isValidBloqueoEspacio(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.espacio is string && data.espacio.size() <= 150 &&
             data.fechaInicio is string && data.fechaInicio.size() <= 10 &&
             data.fechaFin is string && data.fechaFin.size() <= 10 &&
             data.motivo is string && data.motivo.size() <= 100 &&
             data.todoElDia is bool &&
             data.activo is bool;
    }

    // 1. Reservas Collection (Colección única activa: reservas)
    // reservas_comunitarias_v2 queda expresamente cerrada por desuso de versiones anteriores
    match /reservas_comunitarias_v2/{reservaId} {
      allow read, write: if false;
    }

    match /reservas/{reservaId} {
      allow read: if true;
      allow create, update: if isValidId(reservaId) && isValidReserva(incoming());
      allow delete: if isValidId(reservaId);
    }

    // 1.1 Bloqueos de Espacios por Mantención
    match /bloqueos_espacios/{bloqueoId} {
      allow read: if true;
      allow create, update: if isValidId(bloqueoId) && isValidBloqueoEspacio(incoming());
      allow delete: if isValidId(bloqueoId);
    }

    // 2. Usuarios del Sistema Collection
    match /usuarios_sistema/{username} {
      allow read: if true;
      allow create, update: if isValidId(username) && isValidUsuario(incoming());
      allow delete: if isValidId(username);
    }

    // 3. Calificaciones de Espacios Collection
    match /calificaciones_espacios/{calificacionId} {
      allow read: if true;
      allow create, update: if isValidId(calificacionId) && isValidCalificacion(incoming());
      allow delete: if isValidId(calificacionId);
    }

    // 4. Configuración del Sistema Collection
    match /configuracion_sistema/{configId} {
      allow read: if true;
      allow create, update: if isValidId(configId) && isValidConfig(incoming());
      allow delete: if isValidId(configId);
    }

    // 5. Historial de Auditoría (Append-only core data: updates only for revert status, no deletions)
    match /audit_logs/{logId} {
      allow read: if true;
      allow create: if isValidId(logId) && isValidAuditLog(incoming());
      allow update: if isValidId(logId) && isValidAuditUpdate(incoming(), existing());
      allow delete: if false; // Inmutable: nunca se eliminan registros de auditoría
      match /partes/{partId} {
        allow read: if true;
        allow create: if isValidId(logId) && request.resource.data.index is number && request.resource.data.payload is string;
        allow update: if request.resource.data == resource.data;
        allow delete: if false;
      }
    }

    // 6. Tokens FCM
    match /fcm_tokens/{tokenId} {
      allow read: if true;
      allow create, update: if isValidId(tokenId) && isValidFcmToken(incoming());
      allow delete: if isValidId(tokenId);
    }

    // 7. Notificaciones FCM
    match /fcm_notificaciones/{notificationId} {
      allow read: if true;
      allow create, update: if isValidId(notificationId) && isValidFcmNotificacion(incoming());
      allow delete: if isValidId(notificationId);
    }

    // 8. Connection probe testing
    match /_connection_test/{docId} {
      allow read: if true;
    }

    // 9. Copias de Seguridad de la Base de Datos (Automáticas cada 15 días y manuales)
    match /copias_seguridad/{backupId} {
      allow read: if true;
      allow create, update: if isValidId(backupId) && isValidCopiaSeguridad(incoming());
      allow delete: if isValidId(backupId);

      // Fragmentos particionados para copias de gran tamaño (>1MB)
      match /partes/{parteId} {
        allow read: if true;
        allow create, update: if isValidId(backupId) && isValidId(parteId) && isValidCopiaSeguridadParte(incoming());
        allow delete: if isValidId(backupId) && isValidId(parteId);
      }
    }

    // 10. Bloqueos de Concurrencia de Horarios (schedule_slots)
    match /schedule_slots/{slotId} {
      allow read: if true;
      allow create, update: if isValidId(slotId);
      allow delete: if isValidId(slotId);
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

