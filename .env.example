# Las funciones de este proyecto no necesitan una clave de Gemini.

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Correo gratuito: Gmail OAuth o SMTP de Gmail. Sin alternativa comercial.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=cristianshute@gmail.com
SMTP_PASS=
SMTP_FROM=Gestión de Espacios Diaguitas <cristianshute@gmail.com>
GMAIL_USER=cristianshute@gmail.com
GMAIL_APP_PASSWORD=


# Gmail API con renovación automática: credenciales OAuth tipo Aplicación web.
# Registrar exactamente esta URI en Google Cloud; debe usar el dominio real.
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REDIRECT_URI=https://DOMINIO-REAL/api/email/gmail/callback
# Opcional: clave estable para cifrar credenciales. Si está vacía se usa el client secret.
# Sin OAuth, esta clave permite recuperar la sesión temporal tras reiniciar el servidor.
GMAIL_TOKEN_ENCRYPTION_KEY=

# Clave aleatoria de al menos 32 caracteres para el programador existente.
# No requiere crear Cloud Scheduler ni contratar otro servicio.
# Guardar solo en secretos del servidor y en el encabezado X-Scheduler-Token del job.
EMAIL_SCHEDULER_SECRET=

# Clave privada de al menos 32 caracteres para sesiones verificadas del backend.
# Usar el mismo secreto en todas las instancias. Sin clave estable, reiniciar
# requiere iniciar sesión nuevamente; nunca publicar esta clave con VITE_*.
AUTH_SESSION_SECRET=

# Ahorro de lecturas Firestore. VITE_* se aplica al compilar el frontend.
# Historial anterior disponible bajo demanda al navegar por el calendario.
VITE_FIRESTORE_ACTIVE_WINDOW_DAYS=30
# Reutiliza consultas históricas confirmadas durante 60 minutos.
VITE_FIRESTORE_HISTORY_CACHE_MINUTES=60
# El acceso de datos usa la API autenticada; esta opción solo configura el SDK.
# IndexedDB de reservas y recuperación permanece habilitado por separado.
VITE_FIRESTORE_PERSISTENT_CACHE=true
